# Car Neon City Racer - Environment Configuration
# Node Environment ('development' | 'test' | 'staging' | 'production')
NODE_ENV=development

# Host Dynamic Port Allocations (0 = OS dynamic ephemeral allocation)
AIDLC_FRONTEND_PORT=0
AIDLC_API_PORT=0
AIDLC_DB_PORT=0

# Frontend Browser API URL (Defaults to relative /api for reverse proxy)
AIDLC_BROWSER_API_URL=/api

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=car_neon_city_racer
POSTGRES_USER=neon_racer
POSTGRES_PASSWORD=neon_secret_2026
POSTGRES_SSL=false
POSTGRES_MAX_CONNECTIONS=20

# Authentication & JWT Configuration
# Minimum 32-character secure secret
JWT_SECRET=neon-city-racer-dev-jwt-secret-key-32chars-min!!
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# CORS Configuration
CORS_ORIGIN=*

# Storage Boundaries
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Audit Log Configuration
AUDIT_LOGS_ENABLED=true
AUDIT_RETENTION_DAYS=90

# Seed / Reviewer Defaults (For Local / QA Testing)
SEED_ADMIN_EMAIL=admin@car-neon-city-racer.local
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_REVIEWER_EMAIL=reviewer@car-neon-city-racer.local
SEED_REVIEWER_PASSWORD=ChangeMe!12345
SEED_RACER1_EMAIL=racer1@car-neon-city-racer.local
SEED_RACER1_PASSWORD=ChangeMe!12345
